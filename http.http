### =========================
### TRACKS / CHALLENGES
### =========================

### ADMIN - Criar TRACK com CHALLENGES
POST http://localhost:3333/admin/tracks HTTP/1.1
content-type: application/json
Cookie: refreshToken={{refreshToken}}; auth:accessToken={{accessToken}}

{
    "name": "Fundamentos de JavaScript",
    "slug": "fundamentos-javascript",
    "description": "Aprenda os fundamentos da linguagem JavaScript.",
    "icon": "javascript",
    "color": "#F7DF1E",
    "difficulty": "beginner",
    "language": "javascript",
    "isActive": true,
    "challenges": [
        {
            "name": "Qual palavra declara uma constante?",
            "slug": "declarar-constante-javascript",
            "description": "Escolha a palavra-chave correta para declarar uma constante.",
            "points": 10,
            "difficulty": "easy",
            "type": "multiple-choice",
            "isCode": false,
            "tips": ["A constante não pode receber outro valor depois de criada."],
            "alternatives": [
                { "text": "var", "isCorrect": false },
                { "text": "let", "isCorrect": false },
                { "text": "const", "isCorrect": true },
                { "text": "static", "isCorrect": false }
            ],
            "isActive": true
        },
        {
            "name": "Criar função de soma",
            "slug": "criar-funcao-soma",
            "description": "Implemente uma função que some dois números.",
            "points": 20,
            "difficulty": "easy",
            "type": "code",
            "isCode": true,
            "tips": ["Use o operador + para somar os argumentos."],
            "alternatives": [],
            "code": "function sum(a, b) {\n  return a + b;\n}",
            "language": "javascript",
            "isActive": true,
            "codeChallenge": {
                "languageCode": "javascript",
                "functionName": "sum",
                "testCases": [
                    { "input": [2, 3], "expectedOutput": 5, "isHidden": false },
                    { "input": [-1, 4], "expectedOutput": 3, "isHidden": true }
                ],
                "starterCode": "function sum(a, b) {\n  // escreva sua solução\n}",
                "timeLimitMs": 3000,
                "memoryLimitMb": 128
            }
        }
    ]
}

### ADMIN - Criar TRACK com CHALLENGES usando IA
POST http://localhost:3333/admin/tracks/from-prompt HTTP/1.1
content-type: application/json
Cookie: refreshToken={{refreshToken}}; auth:accessToken={{accessToken}}

{
    "prompt": "Crie uma track de nível iniciante sobre arrays em JavaScript com 5 challenges. Inclua 3 challenges de múltipla escolha e 2 challenges de código com casos de teste."
}

### ADMIN - Criar CHALLENGE em uma TRACK existente
POST http://localhost:3333/admin/challenges HTTP/1.1
content-type: application/json
Cookie: refreshToken={{refreshToken}}; auth:accessToken={{accessToken}}

{
    "tracksId": "f2fa86b0-fb5e-4ff8-b928-9c4af6220b97",
    "name": "Inverter uma string",
    "slug": "inverter-uma-string",
    "description": "Crie uma função que inverta os caracteres de uma string.",
    "points": 20,
    "difficulty": "easy",
    "type": "code",
    "isCode": true,
    "tips": ["Você pode usar split, reverse e join."],
    "alternatives": [],
    "code": "function reverseString(text) {\n  return text.split('').reverse().join('');\n}",
    "language": "javascript",
    "isActive": true,
    "codeChallenge": {
        "languageCode": "javascript",
        "functionName": "reverseString",
        "testCases": [
            { "input": ["codequest"], "expectedOutput": "tseuqedoc" },
            { "input": ["javascript"], "expectedOutput": "tpircsavaj", "isHidden": true }
        ],
        "starterCode": "function reverseString(text) {\n  // escreva sua solução\n}",
        "timeLimitMs": 3000,
        "memoryLimitMb": 128
    }
}

### List all TRACKS 
GET http://localhost:3333/tracks HTTP/1.1
content-type: application/json
Cookie: refreshToken={{refreshToken}}; auth:accessToken={{accessToken}}


### List one TRACKS 
GET http://localhost:3333/challenges/javascript HTTP/1.1
content-type: application/json
Cookie: refreshToken={{refreshToken}}; auth:accessToken={{accessToken}}


### List all challenge by trackSlug 
GET http://localhost:3333/challenges/list-one/test HTTP/1.1
content-type: application/json
Cookie: refreshToken={{refreshToken}}; auth:accessToken={{accessToken}}


### Complete challenge 
POST http://localhost:3333/challenges/complete/test HTTP/1.1
content-type: application/json
Cookie: refreshToken={{refreshToken}}; auth:accessToken={{accessToken}}

{
    "trackId": "f2fa86b0-fb5e-4ff8-b928-9c4af6220b97",
    "res": "Opção C"
}


### Complete challenge code
POST http://localhost:3333/challenges/complete-code/test HTTP/1.1
content-type: application/json
Cookie: refreshToken={{refreshToken}}; auth:accessToken={{accessToken}}

{
    "code": "function sum(a, b) { return a + b + a }"
}

### List my information
GET http://localhost:3333/my HTTP/1.1
content-type: application/json
Cookie: refreshToken={{refreshToken}}; auth:accessToken={{accessToken}}




